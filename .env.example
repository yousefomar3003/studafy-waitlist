# Frontend configuration. Copy to .env and fill in.
#
# VITE_API_URL: The base URL of your Vercel deployment.
# In production, set to https://your-domain.com
# In development, leave empty to use the stub (no real submission).

VITE_API_URL=

# ──────────────────────────────────────────────────────────────────
# Backend environment variables (set in Vercel Dashboard → Settings → Environment Variables)
#
# NEVER put these in .env or any file with a VITE_ prefix.
# NEVER commit them to git.
# ──────────────────────────────────────────────────────────────────
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-google-app-password
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# WAITLIST_POSITION_OFFSET=186
